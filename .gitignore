# Sphinx 构建产物（仅源文件入版本库；发布用 gh-pages 分支承载构建结果）
docs/_build/

# 内部版文档目录（含公司内部信息：产品定位 / 内部需求与项目编号 / 实施里程碑）
# 仅在内网构建与发布，绝不进入公开仓库
docs/_internal/

# Visual Studio 工作区缓存（绝不入版本库）
.vs/

# 本地预览产物目录（仅保留空目录占位 .gitkeep）
docs/_preview_html/*
!docs/_preview_html/.gitkeep

# PlantUML 引擎（约 30MB，由 scripts/render_uml.py 自动获取，不入版本库）
tools/plantuml/*.jar

# 临时截图
_shot*.png

