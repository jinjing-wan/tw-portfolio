@startuml download_file_class
' HLD — downloadFile parameter definition
' Render: python scripts/render_uml.py
skinparam dpi 160
skinparam classAttributeIconSize 0
skinparam shadowing false
hide circle
hide empty members

title downloadFile — request / response parameter definition

class DownloadFileRequest {
  reqId : uint32
  fileName : string
  fileType : FileType
  fileSize : uint64
  checksum : string
  ftpServerIp : string
  ftpServerPort : uint16
  ftpUserName : string
  ftpPassword : string
  transferMode : TransferMode
  ftpMode : FtpMode
  targetPath : string
  timeoutSec : uint16
}

class DownloadFileResponse {
  resultCode : ResultCode
  errorCode : uint16
  transferredBytes : uint64
  checksumVerified : bool
  faultId : uint16
}

enum FileType {
  SW_IMAGE
  CONFIG
  LICENSE
  LOG
}

enum TransferMode {
  BINARY
  ASCII
}

enum FtpMode {
  PASSIVE
  ACTIVE
}

enum ResultCode {
  SUCCESS
  FAIL
  TIMEOUT
}

DownloadFileRequest --> FileType : fileType
DownloadFileRequest --> TransferMode : transferMode
DownloadFileRequest --> FtpMode : ftpMode
DownloadFileResponse --> ResultCode : resultCode
DownloadFileRequest ..> DownloadFileResponse : returns

@enduml
